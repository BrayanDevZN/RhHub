# Copie para .env (nunca versione o .env). Usado pelo docker-compose.yml.
POSTGRES_PASSWORD=troque-esta-senha
REDIS_PASSWORD=troque-esta-senha
KAFKA_API_KEY=                    # 32+ caracteres: letras, numeros, _ ou -

ADMIN_EMAIL=                      # admin raiz (@gmail.com)
ADMIN_PASSWORD=                   # 8+ caracteres, com maiuscula, minuscula e numero
JWT_SECRET=                       # opcional: vazio gera um segredo aleatorio a cada subida

# IA e e-mail
groq_key=
open_ai_key=
gmail_secret=

# Front em http local: cookies sem Secure
FRONTEND_ORIGIN=http://localhost:9000
COOKIE_SECURE=false
