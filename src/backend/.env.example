# Copie para .env. Nunca versione o .env.
ENVIRONMENT=production            # "test" troca a IA por uma resposta fixa

# PostgreSQL: postgresql://usuario:senha@host:5432/banco
# none (ou vazio): usa o SQLite local em SQLITE_PATH
DATABASE_URL=none
SQLITE_PATH=./data/rhhub.db
DATABASE_POOL_SIZE=10

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
