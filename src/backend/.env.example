# Copie para .env. Nunca versione o .env.
ENVIRONMENT=production            # "test" troca a IA por uma resposta fixa

# PostgreSQL: postgresql://usuario:senha@host:5432/banco
# none (ou vazio): usa o SQLite local em SQLITE_PATH
DATABASE_URL=none
SQLITE_PATH=./data/rhhub.db
DATABASE_POOL_SIZE=10

# Redis: sem estas variáveis usa localhost:6379 sem senha
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=                   # vazio ou none: conecta só com host e porta

# Kafka: none ou vazio usa localhost:9092. Com a chave, conecta por SASL/PLAIN.
KAFKA_URL=none
KAFKA_API_USER=rhhub
KAFKA_API_KEY=                    # mínimo 32 caracteres [A-Za-z0-9_-] (o mesmo do Dockerfile.kafka)
KAFKA_CONSUMERS_ENABLED=true      # false na API (só publica). O serviço consumer deixa true

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GROQ_API_KEY=                     # também lida de groq_key
GROQ_MODEL=openai/gpt-oss-120b

# E-mail enviado pelo workflow "gmail" do n8n
gmail_secret=                   # o mesmo segredo da credencial JWT do webhook (HS256)
N8N_EMAIL_WEBHOOK_URL=https://n8n.nexoaicompany.com/webhook/a043ad9f-9a0c-4bbd-a142-f64a1cd524c0

# Autenticação
JWT_SECRET=                       # vazio: segredo aleatório a cada subida (sessões acabam ao reiniciar)
ADMIN_EMAIL=                      # admin raiz (@gmail.com)
ADMIN_PASSWORD=
RATE_LIMIT=60                     # requisições por minuto, por IP ou token
GLOBAL_RATE_LIMIT=1000

# Login com Google (desligado por padrão)
GOOGLE_OAUTH_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# Web
FRONTEND_URL=                     # URL do front (CORS e destino do login com Google); várias, separadas por vírgula
COOKIE_SECURE=                    # vazio: ligado. Use false só em http local
COOKIE_SAMESITE=Strict            # Strict exige front e API no mesmo domínio
CACHE_ENABLED=true                # false desliga o cache Redis das leituras
