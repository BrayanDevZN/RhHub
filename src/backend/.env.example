# Copie para .env. Nunca versione o .env.
ENVIRONMENT=production            # "test" troca a IA por uma resposta fixa
JWT_SECRET=troque-por-um-segredo-com-no-minimo-32-caracteres

DATABASE_URL=jdbc:postgresql://localhost:5432/rhhub
DATABASE_USER=rhhub
DATABASE_PASSWORD=rhhub

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_SECURITY_PROTOCOL=PLAINTEXT # SASL_PLAINTEXT quando usar o Dockerfile.kafka
KAFKA_JAAS_ENABLED=false          # true junto com SASL_PLAINTEXT
KAFKA_API_USER=rhhub
KAFKA_API_KEY=                    # mínimo 32 caracteres [A-Za-z0-9_-]

MAIL_ENABLED=true
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
